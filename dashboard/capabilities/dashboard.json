{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dashboard",
  "description": "Minimal IPC allowlist: exactly the thirty dashboard commands, and no core plugin permissions.",
  "windows": ["main"],
  "permissions": [
    "allow-get-status",
    "allow-pin-status",
    "allow-probe-fingerprint",
    "allow-unlock",
    "allow-lock",
    "allow-health",
    "allow-overview-refresh",
    "allow-projects-list",
    "allow-project-add",
    "allow-project-remove",
    "allow-project-path-add",
    "allow-project-path-remove",
    "allow-secrets-list",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-agents-list",
    "allow-agent-add",
    "allow-agent-revoke",
    "allow-grants-list",
    "allow-grant-set",
    "allow-grant-revoke",
    "allow-approvals-pending",
    "allow-approval-approve",
    "allow-approval-deny",
    "allow-reveal",
    "allow-leases-list",
    "allow-lease-revoke",
    "allow-runs-list",
    "allow-audit-show",
    "allow-audit-verify"
  ]
}
